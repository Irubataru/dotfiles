[hub]
  protocol = https
[user]
  name = {{ git.full_name }}
  email = {{ git.email }}
{% if git.sign.key_type == "openpgp" %}
  signingkey = {{ git.sign.key }}
{% elif git.sign.key_type == "ssh" %}
  signingkey = "{{ home_directory }}/.ssh/{{ git.sign.key_name }}.pub" 
{% endif %}
[alias]
  exclude = !sh -c 'echo "$1" >> .git/info/exclude' -
  clean-vba = checkout -- **/*.frm **/*.frx
  clone-worktree = !_git_clone_worktree
  branch-worktree = !_git_branch_worktree
  remote-worktree = !_git_remote_worktree
[column]
  ui = auto
[color]
  diff = auto
  status = auto
  branch = auto
  ui = true
[core]
  excludesfile = ~/.gitignore
  editor = nvim
{% if git.difftool == "delta" %}
  pager = delta
{% endif %}
[help]
  autocorrect = prompt
[apply]
  whitespace = nowarn
[mergetool]
  keepBackup = false
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[difftool]
  prompt = false
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[init]
	defaultBranch = main
{% if git.sign.key_type | default(false) %}
[commit]
  verbose = true
  gpgsign = true
[gpg]
  format = {{ git.sign.key_type }} 
{% endif %}
[credential]
	helper = cache --timeout=27000
[fetch]
  prune = true
  pruneTags = true
  all = true
[push]
  default = simple
	autoSetupRemote = true
  followTags = true
[pull]
	ff = only
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[rerere]
	enabled = true
  autoupdate = true
{% if git.difftool == "delta" %}
[delta]
  side-by-side = true
  features = gruvbox-dark
[interactive]
  diffFilter = delta --color-only
[merge]
  conflictstyle = zdiff3
{% endif %}
{% if data.system.work == "spn" %}
[includeIf "gitdir:~/Projects/"]
  path = .gitconfig-spn
{% endif %}
